#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
main.py - Оптимізований головний контролер
"""

import os
import sys
import time
import logging
import subprocess
import pyperclip
from pathlib import Path

# Налаштування логування
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s"
)
logger = logging.getLogger("main_controller")

def run_script(script_name, args=None, timeout=120):
    """Запуск скрипта з мінімальним overhead"""
    try:
        cmd = [sys.executable, script_name]
        if args:
            cmd.extend(args)
        
        result = subprocess.run(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=timeout
        )
        
        return result.returncode == 0
            
    except subprocess.TimeoutExpired:
        logger.error(f"⏰ Таймаут {script_name}")
        return False
    except Exception as e:
        logger.error(f"❌ Помилка {script_name}: {e}")
        return False

def get_response_from_clipboard():
    """Отримати відповідь з буфера обміну"""
    try:
        response = pyperclip.paste()
        if response and response.strip():
            logger.info(f"✅ Отримано відповідь ({len(response)} символів)")
            return response.strip()
        logger.warning("⚠️ Буфер обміну порожній")
        return None
    except Exception as e:
        logger.error(f"❌ Помилка читання буфера: {e}")
        return None

def get_input_folder():
    """Отримати папку введення"""
    try:
        import yaml
        with open("config.yaml", "r", encoding="utf-8") as f:
            config = yaml.safe_load(f)
        return config.get("input_folder", "input")
    except Exception:
        return "input"

def main():
    """Головна функція"""
    start_time = time.time()
    logger.info("🎬 Запуск контролера перекладу")
    
    # Ініціалізація
    if not os.path.exists("config.yaml"):
        logger.info("📝 Створення конфігу...")
        run_script("0_create_default_config.py")
    
    run_script("1_folder_loader.py")
    
    if not run_script("2_launch_gemini.py"):
        logger.error("❌ Не вдалося запустити браузер")
        return 1
    
    time.sleep(1.5)  # Скорочено з 2
    
    # Отримання файлів
    input_folder = get_input_folder()
    
    if not os.path.exists(input_folder):
        logger.error(f"❌ Папка {input_folder} не існує")
        return 1
        
    files = sorted(Path(input_folder).glob("*.txt"))
    
    if not files:
        logger.error("❌ Не знайдено файлів")
        return 1
    
    logger.info(f"📁 Знайдено {len(files)} файлів")
    
    successful = 0
    
    # Обробка файлів
    for i, file_path in enumerate(files, 1):
        logger.info(f"📄 [{i}/{len(files)}] {file_path.name}")
        
        # Відкрити чат
        run_script("3_open_temp_chat.py")
        time.sleep(0.5)  # Скорочено з 0.8
        
        # Відправити
        if run_script("4_send.py", [str(file_path)]):
            logger.info("⏳ Очікування відповіді...")
            time.sleep(8)  # Затримка для генерації
            
            # Копіювати
            if run_script("5_copy.py"):
                response = get_response_from_clipboard()
                
                if response:
                    # Зберегти
                    if run_script("6_save_response.py", [str(file_path), response]):
                        successful += 1
                        logger.info(f"✅ {file_path.name} оброблено")
                        
                        # Оновити злитий файл
                        run_script("7_update_merged.py")
                        time.sleep(0.2)  # Скорочено з 0.4
                    else:
                        logger.error(f"❌ Не вдалося зберегти {file_path.name}")
                else:
                    logger.error(f"❌ Не отримано відповідь для {file_path.name}")
            else:
                logger.error(f"❌ Помилка копіювання для {file_path.name}")
        else:
            logger.error(f"❌ Не вдалося відправити {file_path.name}")
        
        # Затримка між файлами
        if i < len(files):  # Не чекати після останнього
            time.sleep(0.2)  # Скорочено з 0.3
    
    # Статистика
    total_seconds = int(time.time() - start_time)
    minutes, seconds = divmod(total_seconds, 60)
    
    logger.info(f"📊 Результат: {successful}/{len(files)} файлів")
    
    if minutes > 0:
        print(f"\n⏱️ Час виконання: {minutes} хв {seconds} сек")
    else:
        print(f"\n⏱️ Час виконання: {seconds} сек")
    
    if successful == len(files):
        logger.info("🎉 Всі файли оброблено!")
        return 0
    else:
        logger.warning(f"⚠️ Оброблено {successful}/{len(files)} файлів")
        return 1

if __name__ == "__main__":
    try:
        exit_code = main()
        sys.exit(exit_code)
    except KeyboardInterrupt:
        logger.info("⏹️ Перервано користувачем")
        sys.exit(0)
    except Exception as e:
        logger.error(f"💥 Критична помилка: {e}")
        sys.exit(1)
