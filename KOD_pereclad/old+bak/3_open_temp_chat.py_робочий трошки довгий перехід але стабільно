#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
open_temp_chat.py
Короткий інструмент: підключається до відкритого Chrome через CDP і відкриває "Тимчасовий чат".
Використовує приклад з KOD_pereclad.py як орієнтир. #GPT
"""
import time
import logging
from pathlib import Path

# Зовнішні бібліотеки
try:
    from playwright.sync_api import sync_playwright, TimeoutError as PlaywrightTimeoutError
except Exception as e:
    raise RuntimeError("Відсутні залежності. Виконайте:\n  pip install playwright\n  playwright install") from e

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger("open_temp_chat")

DEFAULT_CDP_PORT = 9222
DEFAULT_WAIT = 3.5
GEMINI_URL = "https://gemini.google.com/app"

def connect_to_chrome(cdp_port: int = DEFAULT_CDP_PORT, timeout_s: int = 5):
    """Підключаємось до вже запущеного Chrome через CDP і повертаємо conn об'єкт. #GPT"""
    url = f"http://127.0.0.1:{cdp_port}"
    play = None
    conn = None
    start = time.time()
    while True:
        try:
            play = sync_playwright().start()
            conn = play.chromium.connect_over_cdp(url)
            logger.info("Підключено до CDP: %s", url)
            return play, conn
        except Exception as e:
            elapsed = time.time() - start
            if elapsed >= timeout_s:
                if play:
                    try:
                        play.stop()
                    except Exception:
                        pass
                raise RuntimeError(f"Не вдалося підключитися до Chrome CDP за {timeout_s}s: {e}")
            time.sleep(1.8)

def choose_target_page(conn):
    """Покращена логіка вибору сторінки: шукаємо вкладку з 'Google Gemini' у заголовку або URL"""
    pages = []
    # підтримка варіантів API: conn.pages або контексти
    try:
        pages = getattr(conn, "pages", []) or []
    except Exception:
        pages = []
    # Пробуємо знайти додатково в контекстах
    try:
        contexts = getattr(conn, "contexts", []) or []
        for ctx in contexts:
            ctx_pages = getattr(ctx, "pages", []) or []
            for p in ctx_pages:
                if p not in pages:
                    pages.append(p)
    except Exception:
        pass

    # Якщо немає сторінок — створюємо нову
    if not pages:
        try:
            page = conn.new_page()
            return page
        except Exception:
            return None

    logger.info(f"Знайдено {len(pages)} вкладок")
    
    # Логуємо всі знайдені вкладки для діагностики
    for i, page in enumerate(pages):
        try:
            page_url = page.url or "невідомий URL"
            page_title = page.title() or "без заголовка"
            logger.info(f"Вкладка {i}: {page_title} - {page_url}")
        except Exception as e:
            logger.info(f"Вкладка {i}: не вдалося отримати інформацію - {e}")
    
    # ВИПРАВЛЕНА логіка пошуку вкладки Gemini
    gemini_page = None
    target_keywords = ["google gemini", "gemini"]
    
    for page in pages:
        try:
            page_title = (page.title() or "").lower()
            page_url = (page.url or "").lower()
            
            # Перевіряємо заголовок
            for keyword in target_keywords:
                if keyword in page_title:
                    gemini_page = page
                    logger.info(f"✓ Знайдено вкладку Gemini за заголовком: {page.title()}")
                    return gemini_page
            
            # Перевіряємо URL
            if "gemini.google.com" in page_url:
                gemini_page = page
                logger.info(f"✓ Знайдено вкладку Gemini за URL: {page.url}")
                return gemini_page
                
        except Exception as e:
            logger.debug(f"Помилка перевірки вкладки: {e}")
            continue
    
    # Якщо не знайшли Gemini, повертаємо першу доступну вкладку
    if pages:
        logger.warning(f"Не знайдено специфічну вкладку Gemini, використовую першу доступну")
        return pages[0]
    
    return None

def activate_gemini_tab(page):
    """Активувати вкладку Gemini"""
    try:
        if page:
            page.bring_to_front()
            logger.info("Вкладка Gemini активована")
            time.sleep(1.1)
            return True
    except Exception as e:
        logger.error(f"Помилка активації вкладки: {e}")
    return False

def is_sidebar_expanded(page) -> bool:
    """Перевіряє, чи бокове меню вже розгорнуте"""
    try:
        # Якщо є tooltip "Згорнути меню", значить меню розгорнуте
        body_html = page.content()
        collapse_indicators = [
            "Згорнути меню",
            "Collapse menu"
        ]
        
        for indicator in collapse_indicators:
            if indicator in body_html:
                logger.info("✓ Бокове меню вже розгорнуте")
                return True
        
        return False
    except Exception as e:
        logger.debug(f"Помилка перевірки стану меню: {e}")
        return False

def expand_sidebar_menu(page) -> bool:
    """Розгортає бокове меню, якщо воно згорнуте"""
    try:
        # Спочатку перевіряємо, чи меню вже розгорнуте
        if is_sidebar_expanded(page):
            logger.info("Меню вже розгорнуте, пропускаю розгортання")
            return True
        
        logger.info("Меню згорнуте, спроба розгорнути...")
        
        # Шукаємо кнопку "Розгорнути меню"
        expand_selectors = [
            'button[aria-label*="Розгорнути меню"]',
            'button[aria-label*="Expand menu"]',
            'button[mattooltip*="Розгорнути меню"]',
            'button[mattooltip*="Expand menu"]',
            # За data-describedby
            'button[aria-describedby*="cdk-describedby-message"]',
        ]
        
        for sel in expand_selectors:
            try:
                btn = page.query_selector(sel)
                if btn and btn.is_visible():
                    logger.info(f"Знайдено кнопку розгортання меню: {sel}")
                    btn.click()
                    time.sleep(1.0)  # Даємо час меню розгорнутися
                    logger.info("✓ Бокове меню розгорнуто")
                    return True
            except Exception as e:
                logger.debug(f"Селектор {sel} не спрацював: {e}")
                continue
        
        # Додаткова спроба через текстовий пошук
        try:
            all_buttons = page.query_selector_all('button')
            for btn in all_buttons:
                try:
                    aria_label = btn.get_attribute('aria-label') or ""
                    tooltip = btn.get_attribute('mattooltip') or ""
                    
                    if 'розгорнути' in aria_label.lower() or 'expand' in aria_label.lower():
                        logger.info(f"Знайдено кнопку через aria-label: '{aria_label}'")
                        btn.click()
                        time.sleep(1.0)
                        logger.info("✓ Бокове меню розгорнуто")
                        return True
                    
                    if 'розгорнути' in tooltip.lower() or 'expand' in tooltip.lower():
                        logger.info(f"Знайдено кнопку через tooltip: '{tooltip}'")
                        btn.click()
                        time.sleep(1.0)
                        logger.info("✓ Бокове меню розгорнуто")
                        return True
                except Exception:
                    continue
        except Exception as e:
            logger.debug(f"Текстовий пошук кнопки меню не вдався: {e}")
        
        logger.debug("Кнопка розгортання меню не знайдена (можливо, меню вже розгорнуте)")
        return False
        
    except Exception as e:
        logger.debug(f"Помилка при розгортанні меню: {e}")
        return False

def check_temp_chat_active(page) -> bool:
    """Перевіряє, чи активний тимчасовий чат на сторінці"""
    try:
        body = page.inner_text('body', timeout=1000) or ""
    except Exception:
        return False
    
    indicators = [
        "Тимчасовий чат",
        "temporary chat",
        "не використовуються для навчання",
        "зберігаються протягом",
        "won't be used to train",
        "will be deleted"
    ]
    
    for ind in indicators:
        if ind.lower() in body.lower():
            return True
    return False

def wait_for_temp_chat_activation(page, timeout_s: float = 10.0, check_interval: float = 0.5) -> bool:
    """
    Динамічно відслідковує переключення на тимчасовий чат.
    Повертає True, якщо тимчасовий чат активовано протягом timeout_s секунд.
    """
    logger.info(f"Очікування активації тимчасового чату (таймаут: {timeout_s}s)...")
    start = time.time()
    
    while time.time() - start < timeout_s:
        if check_temp_chat_active(page):
            elapsed = time.time() - start
            logger.info(f"✓ Тимчасовий чат активовано! (за {elapsed:.2f}s)")
            return True
        time.sleep(check_interval)
    
    logger.warning(f"Таймаут очікування активації тимчасового чату ({timeout_s}s)")
    return False

def focus_input_field(page) -> bool:
    """Встановлює фокус на поле вводу"""
    focus_selectors = [
        'textarea[aria-label*="Enter a prompt"]',
        'textarea[aria-label*="Введіть запит"]',
        'div[contenteditable="true"]',
        'textarea[placeholder*="prompt"]',
        'textarea'
    ]
    
    for fs in focus_selectors:
        try:
            f = page.query_selector(fs)
            if f and f.is_visible():
                f.click()
                time.sleep(0.5)
                logger.info(f"Фокус встановлено на поле вводу (селектор: {fs})")
                return True
        except Exception:
            continue
    
    logger.debug("Не вдалося встановити фокус на поле вводу")
    return False

def open_temp_chat_on_page(page, wait_after_reload: float = DEFAULT_WAIT):
    """Переходить на сторінку Gemini та намагається клікнути кнопку 'Тимчасовий чат'. Повертає True/False. #GPT"""
    if page is None:
        logger.error("Сторінка не передана")
        return False

    try:
        # Активуємо вкладку Gemini перед початком роботи
        if not activate_gemini_tab(page):
            logger.error("Не вдалося активувати вкладку Gemini")
            return False

        # Переходимо на сторінку Gemini замість оновлення
        try:
            logger.info(f"Перехід на сторінку: {GEMINI_URL}")
            page.goto(GEMINI_URL, timeout=15000, wait_until="domcontentloaded")
        except PlaywrightTimeoutError:
            logger.warning("Перехід на сторінку timeout, продовжую...")
        except Exception as e:
            logger.warning(f"Помилка переходу на сторінку: {e}, продовжую...")

        # Даємо час скриптам та DOM стабілізуватися
        try:
            page.wait_for_load_state('networkidle', timeout=3000)
        except Exception:
            pass
        time.sleep(wait_after_reload)

        # НОВИНКА: Спочатку розгортаємо бокове меню
        logger.info("Перевірка стану бокового меню...")
        expand_sidebar_menu(page)
        time.sleep(0.5)  # Невелика пауза після розгортання

        # Перевіряємо, чи вже активний тимчасовий чат
        if check_temp_chat_active(page):
            logger.info("Тимчасовий чат вже активний!")
            focus_input_field(page)
            return True

        # Набір селекторів для кнопки "Тимчасовий чат"
        selectors = [
            'button[data-test-id="temp-chat-button"]',
            'button[aria-label*="Тимчасовий чат"]',
            'button[aria-label*="Temporary chat"]',
            'button[mattooltip*="Тимчасовий чат"]',
            'button[mattooltip*="Temporary chat"]',
            'button.temp-chat-button',
            'button:has-text("Тимчасовий чат")',
            'button:has-text("Temporary chat")',
            # Додаткові варіанти
            '[data-test-id*="temp"]',
            '[aria-label*="temp"]',
            'button[aria-label*="тимчасов"]'
        ]

        clicked = False
        for sel in selectors:
            try:
                el = None
                try:
                    page.wait_for_selector(sel, timeout=2000, state='visible')
                    el = page.query_selector(sel)
                except Exception:
                    el = page.query_selector(sel)
                
                if not el:
                    continue

                # Перевіряємо видимість
                try:
                    if not el.is_visible():
                        continue
                except Exception:
                    pass

                logger.info(f"Знайдено селектор: {sel} — пробую клік.")
                
                # Спроба прокрутити до елемента
                try:
                    el.scroll_into_view_if_needed()
                    time.sleep(0.3)
                except Exception:
                    pass

                # Різні методи кліку
                click_methods = [
                    ('JavaScript click', lambda: page.evaluate(f"document.querySelector('{sel}')?.click()")),
                    ('Direct click', lambda: el.click(timeout=1500)),
                    ('Force click', lambda: el.click(force=True, timeout=1500))
                ]
                
                for method_name, click_fn in click_methods:
                    try:
                        click_fn()
                        logger.info(f"Клік виконано методом: {method_name}")
                        clicked = True
                        break
                    except Exception as e:
                        logger.debug(f"Метод {method_name} не спрацював: {e}")
                        continue

                if clicked:
                    # Динамічне очікування активації тимчасового чату
                    if wait_for_temp_chat_activation(page, timeout_s=5.0):
                        focus_input_field(page)
                        return True
                    else:
                        # Можливо, чат активовано, але індикатори не знайдені
                        logger.info("Клік виконано, але індикатори не підтверджені. Спроба встановити фокус...")
                        focus_input_field(page)
                        return True

            except Exception as e:
                logger.debug(f"Помилка при обробці селектора {sel}: {e}")
                continue

        if not clicked:
            logger.warning("Не знайдено жодного селектора для 'Тимчасовий чат'")
            
            # Остання спроба: пошук через текст на сторінці
            try:
                logger.info("Спроба знайти кнопку через текстовий пошук...")
                all_buttons = page.query_selector_all('button')
                for btn in all_buttons:
                    try:
                        btn_text = btn.inner_text().lower()
                        aria_label = (btn.get_attribute('aria-label') or "").lower()
                        tooltip = (btn.get_attribute('mattooltip') or "").lower()
                        
                        if any(keyword in btn_text or keyword in aria_label or keyword in tooltip 
                               for keyword in ['тимчасов', 'temporary']):
                            logger.info(f"Знайдено кнопку через атрибути: текст='{btn.inner_text()}', aria-label='{aria_label}'")
                            btn.click()
                            if wait_for_temp_chat_activation(page, timeout_s=10.0):
                                focus_input_field(page)
                                return True
                    except Exception:
                        continue
            except Exception as e:
                logger.debug(f"Текстовий пошук не вдався: {e}")
        
        return False

    except Exception as e:
        logger.exception(f"Помилка у open_temp_chat_on_page: {e}")
        return False

def main(cdp_port: int = DEFAULT_CDP_PORT):
    """Головна функція виконання. #GPT"""
    play = None
    conn = None
    try:
        play, conn = connect_to_chrome(cdp_port=cdp_port, timeout_s=5)
        page = choose_target_page(conn)
        if not page:
            logger.error("Не знайдено доступної сторінки/вкладки у Chrome")
            return 1
        
        # Додаткова перевірка: чи це дійсно вкладка Gemini
        try:
            page_title = page.title() or ""
            page_url = page.url or ""
            if "gemini" not in page_title.lower() and "gemini.google.com" not in page_url:
                logger.warning("Обрана вкладка не є Gemini. Можливо, буде проблема з відкриттям тимчасового чату.")
        except Exception:
            pass
            
        ok = open_temp_chat_on_page(page, wait_after_reload=2.5)
        if ok:
            logger.info("✓ Операція завершена успішно: 'Тимчасовий чат' активовано.")
            return 0
        else:
            logger.error("✗ Не вдалося відкрити 'Тимчасовий чат'.")
            return 2
    finally:
        try:
            if conn:
                try:
                    conn.close()
                except Exception:
                    pass
            if play:
                try:
                    play.stop()
                except Exception:
                    pass
        except Exception:
            pass

if __name__ == "__main__":
    # Якщо потрібно, змініть порт тут або передайте іншим способом. #GPT
    raise SystemExit(main(cdp_port=9222))