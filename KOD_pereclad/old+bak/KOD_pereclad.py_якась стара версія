                            while len(pages) < 3:
                                pages.append(self.conn.new_page())
                            self.page = pages[2]
                        
                        return True
                    except Exception as e2:
                        logger.error("❌ Повторне підключення не вдалося: %s", e2)
                else:
                    logger.error("❌ Не вдалося запустити Chrome автоматично")
