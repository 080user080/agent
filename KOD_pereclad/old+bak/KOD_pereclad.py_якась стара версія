    def ensure_third_tab_and_open_gemini(self):
        # Надійна логіка: знайти існуючу вкладку з Gemini або Google, інакше використати першу наявну вкладку, або створити нову.
        pages = []
        try:
            pages = getattr(self.conn, 'pages', None) or []
        except Exception:
            pages = []

        # Додатково спробуємо отримати сторінки з контекстів (залежно від версії playwright)
        try:
            contexts = getattr(self.conn, 'contexts', None) or []
            for ctx in contexts:
                try:
                    ctx_pages = getattr(ctx, 'pages', None) or []
                    for pg in ctx_pages:
                        if pg not in pages:
                            pages.append(pg)
                except Exception:
                    continue
        except Exception:
            pass

        # Шукаймо вкладку, яка вже відкрита на Gemini/Google
        chosen = None
        for pg in pages:
            try:
                u = ''
                t = ''
                try:
                    u = pg.url or ''
                except Exception:
                    u = ''
                try:
                    t = pg.title() or ''
                except Exception:
                    t = ''
                if 'gemini' in u.lower() or 'gemini' in t.lower() or 'google' in t.lower():
                    # Перевірити, чи сторінка доступна
                    if hasattr(pg, 'bring_to_front'):
                        chosen = pg
                    break
            except Exception:
                continue

        # Якщо не знайшли, використовуємо логіку запасного вибору
        try:
            if chosen is None:
                if len(pages) >= 3:
                    chosen = pages[2]
                elif pages:
                    # Шукаємо першу доступну сторінку
                    for pg in pages:
                        if hasattr(pg, 'bring_to_front'):
                            chosen = pg
                            break
                # Якщо ще не вибрано сторінку, створюємо нову
                if chosen is None:
                    try:
                        chosen = self.conn.new_page()
                    except Exception:
                        # fallback на першу сторінку якщо існує
                        chosen = pages[0] if pages else None
        except Exception:
            try:
                chosen = self.conn.new_page()
            except Exception:
                chosen = None

        self.page = chosen

        # Відкрити або оновити сторінку Gemini, потім підготувати вкладку.
        try:
            if not self.page:
                logger.error("Сторінка відсутня для відкриття Gemini")
                return

            try:
                self.page.bring_to_front()
            except Exception:
                logger.debug("Не вдалося вивести сторінку на передній план")

            current_url = ""
            try:
                current_url = self.page.url or ""
            except Exception:
                current_url = ""

            # GPT: Алгоритм користувача: (1) Оновити сторінку (F5)
            # Завжди оновлюємо сторінку перед створенням чату, щоб бокова панель була актуальна.
            try:
                logger.info("🔁 Оновлюю сторінку (F5) для актуалізації бокової панелі Gemini")
                # Використовуємо reload замість goto щоб не втратити контекст
                self.page.reload(timeout=int(self.cfg.get('page_load_timeout',30))*1000)
            except PlaywrightTimeoutError:
                logger.warning("Час очікування при оновленні сторінки (F5) сплинув")
                time.sleep(0.5)
            except Exception as e:
                logger.debug("Помилка при перезавантаженні сторінки: %s", e)

            # GPT: Додано очікування стабілізації сторінки ПІСЛЯ F5 (за вимогою)
            logger.info("⏸️ Сторінку оновлено (F5). Очікування стабілізації DOM/JS (1.5с)...")
            try:
                # Спробуємо дочекатися, доки мережа заспокоїться
                self.page.wait_for_load_state('networkidle', timeout=4000)
            except Exception:
                logger.debug("'networkidle' не дочекалися, продовжуємо через time.sleep")
            
            # Додаткова фіксована пауза, як просив користувач
            time.sleep(3.0)  # Збільшено з 1.5 до 3.0 секунд

            logger.info("✅ Gemini готовий до пошуку кнопки 'Тимчасовий чат'")
            return
        except Exception as e:
            logger.warning("Не вдалося підготувати вкладку Gemini: %s", e)
            return

def create_new_chat(self, method="temp_chat_button"):
    logger.info("🔍 Починаю пошук кнопки 'Тимчасовий чат'...")
    try:
        # GPT: Додаткова перевірка, що сторінка існує
        if not self.page:
            logger.error("Сторінка (self.page) не ініціалізована. Неможливо створити чат.")
            return False

        if method == "temp_chat_button":
            # GPT: Алгоритм користувача: (2) Зачекати, щоб сторінка оновилася
            try:
                logger.info("⏳ Очікування стабілізації сторінки після F5...")
                self.page.wait_for_load_state('networkidle', timeout=8000)
            except Exception:
