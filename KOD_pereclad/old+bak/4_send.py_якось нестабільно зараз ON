import os
import sys
import time
import yaml
import logging
import re
import pyperclip
from pathlib import Path

# Налаштування логування
logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger("send_message")

try:
    from playwright.sync_api import sync_playwright
except Exception as e:
    print("Відсутні залежності. Виконайте:\n  pip install playwright\n  playwright install")
    raise

CONFIG_PATH = "config.yaml"

class MessageSender:
    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.play = None
        self.conn = None
        self.page = None
    
    def connect_cdp(self):
        """Підключитися до браузера через CDP і знайти вкладку Google Gemini"""
        port = int(self.cfg.get("cdp_port", 9222))
        url = f"http://127.0.0.1:{port}"
        try:
            self.play = sync_playwright().start()
            self.conn = self.play.chromium.connect_over_cdp(url)
            
            # Отримуємо всі вкладки
            pages = self.conn.contexts[0].pages if self.conn.contexts else self.conn.pages
            
            if not pages:
                logger.error("Не знайдено жодної вкладки")
                return False
            
            logger.info(f"Знайдено {len(pages)} вкладок")
            
            # Шукаємо вкладку Gemini
            for page in pages:
                try:
                    page_url = page.url or ""
                    
                    if "gemini.google.com" in page_url:
                        self.page = page
                        logger.info(f"Знайдено вкладку Gemini")
                        return True
                        
                except Exception:
                    continue
            
            logger.error("Не знайдено вкладку Gemini")
            return False
            
        except Exception as e:
            logger.error(f"Не вдалося підключитися до CDP: {e}")
            return False

    def activate_and_focus(self):
        """Активувати вкладку і сфокусуватися на полі вводу"""
        try:
            # Активація вкладки
            self.page.bring_to_front()
            time.sleep(0.3)
            
            # Селектори для поля вводу
            input_selectors = [
                'div.ql-editor[contenteditable="true"]',
                'rich-textarea[aria-label="Введіть запит"]',
                'div.ql-editor.textarea'
            ]
            
            for selector in input_selectors:
                try:
                    input_field = self.page.query_selector(selector)
                    if input_field:
                        input_field.click()
                        logger.info(f"Поле вводу активовано")
                        time.sleep(0.2)
                        return True
                except Exception:
                    continue
            
            logger.error("Не вдалося знайти поле вводу")
            return False
            
        except Exception as e:
            logger.error(f"Помилка активації: {e}")
            return False

    def send_message(self, text: str):
        """Відправити текст через буфер обміну БЕЗ Enter - натиснути кнопку відправки"""
        try:
            # Копіюємо в буфер
            pyperclip.copy(text)
            time.sleep(0.3)
            
            # Вставляємо текст
            self.page.keyboard.press("Control+V")
            logger.info("Текст вставлено через Ctrl+V")
            time.sleep(0.5)
            
            # ВАРІАНТ 1: Натискаємо кнопку відправки замість Enter
            send_button_selectors = [
                'button[aria-label*="Send"]',
                'button[aria-label*="Надіслати"]',
                'button.send-button',
                'button[type="submit"]',
                'button svg',  # Іконка відправки
            ]
            
            button_clicked = False
            for selector in send_button_selectors:
                try:
                    buttons = self.page.query_selector_all(selector)
                    if buttons:
                        # Беремо останню кнопку (найімовірніше кнопка відправки)
                        send_btn = buttons[-1]
                        if send_btn.is_visible():
                            send_btn.click()
                            logger.info(f"✅ Кнопка відправки натиснута")
                            button_clicked = True
                            break
                except Exception as e:
                    logger.debug(f"Не вдалося натиснути кнопку за селектором {selector}: {e}")
                    continue
            
            if not button_clicked:
                # ВАРІАНТ 2: Якщо кнопку не знайдено - використовуємо Enter
                logger.info("⚠️ Кнопка не знайдена, використовую Enter")
                self.page.keyboard.press("Enter")
            
            time.sleep(0.3)
            
            logger.info("✅ Повідомлення відправлено")
            return True
            
        except Exception as e:
            logger.error(f"Помилка відправки: {e}")
            return False

    def close(self):
        """Закрити з'єднання"""
        try:
            if self.conn:
                self.conn.close()
            if self.play:
                self.play.stop()
        except Exception:
            pass

def load_config():
    """Завантажити конфігурацію"""
    if not os.path.exists(CONFIG_PATH):
        raise FileNotFoundError(f"Не знайдено файл {CONFIG_PATH}")

    with open(CONFIG_PATH, "r", encoding="utf-8") as f:
        cfg = yaml.safe_load(f) or {}

    # Дефолтні значення
    cfg.setdefault("input_folder", "input")
    cfg.setdefault("template_message", "")
    cfg.setdefault("cdp_port", 9222)
    cfg.setdefault("numeric_prefix_regex", r"^\d+")

    return cfg

def scan_files(folder, regex):
    """Сканувати файли за числовим префіксом"""
    files = [p for p in Path(folder).iterdir() if p.suffix.lower() == ".txt"]
    rx = re.compile(regex)
    
    def get_sort_key(f):
        m = rx.match(f.name)
        return int(m.group()) if m else 999999
    
    return sorted(files, key=get_sort_key)

def send_single_file(file_path):
    """Відправити один конкретний файл"""
    try:
        cfg = load_config()
        sender = MessageSender(cfg)
        
        # Підключення і активація
        if not sender.connect_cdp():
            return False
        
        if not sender.activate_and_focus():
            return False
        
        # Підготовка тексту
        text = Path(file_path).read_text(encoding="utf-8", errors="ignore")
        template = cfg.get("template_message", "").strip()
        msg = f"{template}\n\n{text}" if template else text
        
        logger.info(f"📤 Відправка тексту ({len(msg)} символів)")
        
        # Відправка
        success = sender.send_message(msg)
        sender.close()
        
        if success:
            logger.info("✅ Повідомлення відправлено")
        
        return success
        
    except Exception as e:
        logger.error(f"❌ Помилка: {e}")
        return False

def main():
    """Головна функція для відправки всіх файлів"""
    try:
        cfg = load_config()
        input_folder = cfg["input_folder"]
        
        # Скануємо файли
        files = scan_files(input_folder, cfg["numeric_prefix_regex"])
        
        if not files:
            logger.error(f"Не знайдено файлів у {input_folder}")
            return False

        # Створюємо sender один раз
        sender = MessageSender(cfg)
        
        if not sender.connect_cdp():
            return False

        # Обробляємо всі файли
        for i, file_path in enumerate(files, 1):
            logger.info(f"Обробка файлу {i}/{len(files)}: {file_path.name}")

            # Активація і фокус
            if not sender.activate_and_focus():
                logger.error(f"Помилка активації для {file_path.name}")
                continue

            # Читаємо і відправляємо
            text = file_path.read_text(encoding="utf-8", errors="ignore")
            template = cfg["template_message"].strip()
            msg = f"{template}\n\n{text}"

            sender.send_message(msg)
            
            # Затримка між файлами
            time.sleep(0.5)

        logger.info("Всі файли оброблено")
        sender.close()
        return True
        
    except Exception as e:
        logger.error(f"Помилка: {e}")
        return False

if __name__ == "__main__":
    if len(sys.argv) > 1:
        success = send_single_file(sys.argv[1])
        sys.exit(0 if success else 1)
    else:
        main()
