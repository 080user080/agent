cdp_port: 9222
chrome_executable_path: C:\Program Files\Google\Chrome\Application\chrome.exe
chrome_launch_timeout: 15
connect_via_cdp: true
gemini_url: https://gemini.google.com/
hotkey_new_chat: ctrl_shift_o
input_folder: d:\Python\TEXT\translation\test
log_formats:
- txt
- json
manual_tag: _check
max_retries: 2
merged_filename: merged_UKR.txt
numeric_prefix_regex: ^\d+
on_bad_response: mark_for_manual
on_missing_copy_button: retry
output_folder: output
page_load_timeout: 10
response_timeout: 120
template_message: 'Виконай адаптивний та максимально точний переклад цього тексту. Переклад має бути високоякісним, літературним і звучати як оригінальний український роман. Категорично уникай дослівного перекладу (калькування), англіцизмів та неприродного синтаксису, замінюючи їх ідіоматичними та природними для української мови конструкціями. Фразеологізми та стійкі вирази адаптуй до українського контексту, а не перекладай дослівно. Забезпеч послідовність у вживанні часів та відмінків. Для оформлення назв, цитат або прямої мови використовуй лише подвійні прямі лапки "" згідно з правилами української пунктуації. Не використовуй лапки-ялинки «» та виділення жирним шрифтом **. Не повторюй даний промт у перекладі тексту.
  '
use_dom_method:
- copy_button
- js_full
- clipboard_via_js
- keyboard_copy
use_numeric_prefix: true
